# Настройки Троя. Скопируйте этот файл в settings.env (в этой же папке) и впишите свои значения.
# settings.env никуда не выкладывайте — в нём ваши ключи.

# ── Telegram (по желанию: без него Трой работает в программе; подключается и потом — «Подключения») ──
# Токен вашего бота: напишите @BotFather → /newbot → скопируйте токен
TELEGRAM_TOKEN=
# Ваш Telegram ID. Оставьте пустым: при первом сообщении бот сам пришлёт его — впишите сюда и перезапустите.
# Без Telegram — впишите local
ALLOWED_USER_ID=
# Как к вам обращаться (необязательно)
USER_NAME=
# Имя ассистента
BOT_NAME=Трой
# Прокси для Telegram, если он у вас заблокирован (socks5://… или http://…)
TELEGRAM_PROXY=

# ── Groq (обязательно, бесплатно) ──
# Ключ: console.groq.com → API Keys → Create API Key (начинается с gsk_). Карта не нужна
GROQ_API_KEY=
# Цепочка моделей: у каждой свой бесплатный лимит; упёрлась одна — Трой берёт следующую
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# Модель для поиска в интернете и распознавание голосовых
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_PROXY=

# ── Запасной провайдер: Mistral (необязательно, бесплатно) ──
# Ключ: console.mistral.ai → API Keys. Пусто — не используется
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Идеи в GitHub (необязательно) ──
# Без этого идеи хранятся прямо на сервере. С этим — в вашем приватном репозитории (владелец/имя)
GITHUB_REPO=
# Fine-grained токен с доступом только к этому репозиторию, Contents: Read and write
GITHUB_TOKEN=
GITHUB_BRANCH=main

# ── Битрикс24 (необязательно) ──
# Входящий вебхук: Битрикс24 → Разработчикам → Другое → Входящий вебхук,
# права: task, im, crm, user. Сюда — адрес вебхука целиком
BITRIX_WEBHOOK=

# ── Программа на компьютере ──
# Пароль для входа задаётся в Telegram: /password новый_пароль
DESKTOP_PORT=8443

# ── Прочее ──
TIMEZONE=Europe/Moscow
HISTORY_MESSAGES=10
